# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Gemini (server-side only; never put this in VITE_ variables)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048

# Authentication
# In development only, allow the legacy x-user-id header.
ALLOW_DEMO_AUTH=true
# For production, set ALLOW_DEMO_AUTH=false and configure Firebase Admin:
FIREBASE_PROJECT_ID=
# Supply service-account JSON as a single-line JSON string through your hosting secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=20

# Local JSON storage is development-only. Replace with Firestore or another managed DB for production.
